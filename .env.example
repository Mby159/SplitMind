# SplitMind Configuration
# Copy this file to .env and fill in your API keys
#
# 只列 `splitmind/config.py` 的 Settings 真正会读的变量。
# 以下名字当前代码**不读取**（实测：只有 config.py 与 providers/__init__.py 读环境变量，
# 都不读它们），设置不会生效，故注释掉：OPENAI_MODEL、ANTHROPIC_MODEL、KIMI_BASE_URL、KIMI_MODEL。
# 本文件与代码的一致性由 tests/test_env_example.py 守卫。

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Kimi (Moonshot AI) Configuration
KIMI_API_KEY=your-kimi-api-key-here

# Local Model Configuration (Ollama, LM Studio, etc.)
# 注意变量名：代码读的是 LOCAL_MODEL_URL / LOCAL_MODEL_NAME
# （旧示例里写的 LOCAL_BASE_URL / LOCAL_MODEL 是错的，不会被读到）
LOCAL_MODEL_URL=http://localhost:11434/api
LOCAL_MODEL_NAME=llama3.2:3b

# --- 规划中、尚未接线（设置无效，保留以示意图）---
# OPENAI_MODEL=gpt-4
# ANTHROPIC_MODEL=claude-3-opus-20240229
# KIMI_BASE_URL=https://api.moonshot.cn/v1
